# Database Connection Settings (Uncomment and fill to use MySQL; defaults to SQLite portfolio.db)
# DB_HOST=your-mysql-host
# DB_USER=your-mysql-user
# DB_PASSWORD=your-mysql-password
# DB_NAME=your-mysql-database
# DB_PORT=3306

# Encryption Settings (Used for encrypting contact form entries)
ENCRYPTION_KEY=U3VwZXJTZWN1cmVGbGFza015U1FMUGFzc3dvcmRLZXk=

# Gemini API Key (Required for AI assistant. Without this, fallback rules are used)
GEMINI_API_KEY=your-gemini-api-key

# Optional Access Keys for Contact Form Email Routing
# WEB3FORMS_ACCESS_KEY=your-web3forms-key
# SMTP_HOST=smtp.gmail.com
# SMTP_PORT=587
# SMTP_USER=your-email@gmail.com
# SMTP_PASSWORD=your-app-password
# CONTACT_RECEIVER_EMAIL=sanjaygl2006@gmail.com
